# Copy this file to .env.local and fill in your Supabase project values.
# See https://app.supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app, used for building absolute links (e.g. in emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never exposed to the browser -- required for privileged
# writes (Stripe webhook processing, checkout/portal server actions) that
# must bypass RLS. See Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test-mode keys for local development -- see https://dashboard.stripe.com/test/apikeys).
# Server-only secret key. Never exposed to the browser.
STRIPE_SECRET_KEY=
# Signing secret for the local webhook endpoint (from `stripe listen` or
# the Stripe dashboard). Server-only. Never exposed to the browser.
STRIPE_WEBHOOK_SECRET=
